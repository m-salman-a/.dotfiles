// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  // Toggle file explorer
  {
    "context": "Workspace",
    "bindings": {
      "cmd-e": "pane::RevealInProjectPanel",
    },
  },
  {
    "context": "Dock",
    "bindings": {
      "cmd-e": "project_panel::Toggle",
    },
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "cmd-e": "buffer_search::Deploy",
    },
  },
  // File explorer editing
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "d": "project_panel::Delete",
      "r": "project_panel::Rename",
      "y y": "project_panel::Copy",
      "p": "project_panel::Paste",
    },
  },
  // Toggle AI
  {
    "context": "Workspace",
    "bindings": {
      "cmd-l": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-l": "editor::SelectLine",
    },
  },
  // Toggle git panel
  // {
  //   "context": "Workspace",
  //   "bindings": {
  //     "cmd-g": "git_panel::Toggle",
  //   },
  // },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-g": [
        "task::Spawn",
        {
          "task_name": "LazyGit",
        },
      ],
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "cmd-g": "search::SelectNextMatch",
    },
  },
  // Git panel
  {
    "context": "GitPanel && ChangesList",
    "bindings": {
      "ctrl-w j": "git_panel::FocusEditor",
    },
  },
  {
    "context": "GitPanel && CommitEditor",
    "bindings": {
      "ctrl-w k": "git_panel::FocusChanges",
    },
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "unbind": {
      "ctrl-w k": "workspace::ActivatePaneUp",
    },
  },
  {
    "context": "!GitPanel && ((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-w k": "workspace::ActivatePaneUp",
    },
  },
  // Git staging
  {
    "context": "GitDiff && vim_mode == normal",
    "bindings": {
      "space": "git::ToggleStaged",
      "backspace": "git::Restore",
      "n": "editor::GoToHunk",
      "shift-n": "editor::GoToPreviousHunk",
    },
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "space": "vim::WrappingRight",
      "backspace": "vim::WrappingLeft",
      "n": "vim::MoveToNextMatch",
      "shift-n": "vim::MoveToPreviousMatch",
    },
  },
  {
    "context": "!GitDiff && VimControl && !menu",
    "bindings": {
      "space": "vim::WrappingRight",
      "backspace": "vim::WrappingLeft",
      "n": "vim::MoveToNextMatch",
      "shift-n": "vim::MoveToPreviousMatch",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "backspace": "editor::Backspace",
    },
  },
  {
    "context": "!GitDiff && Editor",
    "bindings": {
      "backspace": "editor::Backspace",
    },
  },
  // Open recent workspaces
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-cmd-o": [
        "projects::OpenRecent",
        {
          "create_new_window": true,
        },
      ],
      "alt-cmd-o": [
        "projects::OpenRemote",
        {
          "from_existing_connection": false,
          "create_new_window": false,
        },
      ],
    },
  },
  // Show completion
  {
    "context": "Editor && vim_mode == insert && !showing_completions",
    "bindings": {
      "ctrl-n": "editor::ShowCompletions",
    },
  },
  // Dismiss search bar
  {
    "context": "BufferSearchBar",
    "bindings": {
      "ctrl-l": "buffer_search::Dismiss",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-l": "editor::ScrollCursorCenter",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-l": "buffer_search::Dismiss",
    },
  },
  // Terminal
  {
    "context": "Workspace",
    "bindings": {
      "cmd-t": "workspace::NewCenterTerminal",
    },
  },
  // Diagnostics
  {
    "context": "Workspace",
    "bindings": {
      "cmd-d": "diagnostics::Deploy",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-d": "editor::SelectNext",
    },
  },
  // Window
  {
    "context": "AgentPanel && MessageEditor && vim_mode == insert",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
    },
  },
]
